{
  "name": "aduna-desktop",
  "version": "1.0.0",
  "description": "Aduna desktop app: a window onto your Aduna server",
  "main": "main.js",
  "author": "Aduna",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.aduna.desktop",
    "productName": "Aduna",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "setup.html", "config.json", "build/icon.png"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.ico", "signAndEditExecutable": false },
    "nsis": { "oneClick": true, "perMachine": false, "deleteAppDataOnUninstall": false, "artifactName": "Aduna-Setup-${version}.${ext}" }
  }
}
