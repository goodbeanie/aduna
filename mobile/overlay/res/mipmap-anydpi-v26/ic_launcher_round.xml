<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon. Day: dark logo on cream. Night (mipmap-night-* / values-night): white logo on near-black.
     <monochrome> is the Android 13+ "Themed icons" layer: the system tints it to match the wallpaper and light/dark mode. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
