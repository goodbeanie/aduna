{
  "name": "aduna-desktop",
  "version": "1.4.117",
  "description": "Aduna desktop app: opens aduna.dpdns.org/app",
  "main": "main.js",
  "author": "Aduna",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "rcedit": "^4.0.1"
  },
  "build": {
    "appId": "app.aduna.desktop",
    "productName": "Aduna",
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "games.js",
      "zoom.js",
      "offline.html",
      "titlebar.html",
      "titlebar-preload.js",
      "toast.html",
      "toast-preload.js",
      "page-preload.js",
      "build/icon.png",
      "build/icon-white.png",
      "build/bree-serif.woff2"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Aduna-Setup.${ext}",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "shortcutName": "Aduna"
    },
    "afterPack": "afterPack.js",
    "protocols": [
      {
        "name": "Aduna",
        "schemes": [
          "aduna"
        ]
      }
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://aduna.dpdns.org/updates/"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "optionalDependencies": {
    "uiohook-napi": "^1.5.4"
  }
}
